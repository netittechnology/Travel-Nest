# Server
PORT=5000
NODE_ENV=development

# JWT 
JWT_SECRET=Your_JWT_Secret

# MySQL Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=Database_User
DB_PASSWORD=Database_Password
DB_NAME=Database_Name

# origins
PRODUCTION_ADMIN_PANEL_WEB_URL=Your_Production_admin_panel_Web_URL
PRODUCTION_CLIENT_PANEL_WEB_URL=Your_Production_client_panel_Web_URL
DEVELOPMENT_ADMIN_PANEL_WEB_URL=http://localhost:5173
DEVELOPMENT_CLIENT_PANEL_WEB_URL=http://localhost:5174

# Google OAuth
GOOGLE_CLIENT_ID=Your_Google_Client_Id
GOOGLE_CLIENT_SECRET=Your_Google_Client_Secret
GOOGLE_REDIRECT_URL=http://localhost:5000/auth/google/callback

# Cloudinary
CLOUDINARY_CLOUD_NAME=Your_Cloudinary_Cloud_Name
CLOUDINARY_API_KEY=Your_Cloudinary_API_Key
CLOUDINARY_API_SECRET=Your_Cloudinary_API_Secret

# SMTP - mail server
MAIL_HOST=Your_SMTP_Host
MAIL_PORT=587
MAIL_USER=Your_SMTP_User
MAIL_PASSWORD=Your_SMTP_Password
MAIL_FROM=youremail@gmail.com

# Default admin account
ADMIN_NAME=Super Admin
ADMIN_EMAIL=superadmin@example.com
ADMIN_PASSWORD=ChangeMe@123